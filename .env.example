APP_NAME="NDN Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost/ndn

APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ndn
DB_USERNAME=root
DB_PASSWORD=
# DB 세션 타임존. 앱(APP_TIMEZONE)과 같아야 한다 — 다르면 DB 가 채우는 시각
# (DEFAULT current_timestamp, NOW())만 어긋나 화면에서 9~18시간 틀어진다.
# 이름 있는 지역이 아니라 숫자 오프셋을 쓴다(MySQL 시간대 표가 없어도 통한다).
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 큐를 쓰지 않는다. 알림(메일·FCM)은 요청 자리에서 바로 나간다 —
# 워커가 멈춰 있으면 '보낸 줄 알고' 기다리게 되는 쪽이 더 나쁘다.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 로그인 화면에 테스트 계정 목록 표시(테스트 환경 전용, 운영은 false/미설정)
NDN_SHOW_TEST_LOGINS=false
